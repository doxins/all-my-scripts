-- ───────────────────────────────────────────────────────────────
-- Math Random Hook: Hooks math.random to modify spread for weapons
-- ───────────────────────────────────────────────────────────────
local oldRandom
oldRandom = hookfunction(math.random, LPH_NO_VIRTUALIZE(function(...)
    local args = { ... }
    if checkcaller() then
        return oldRandom(...)
    end
    
    if (#args == 0) or 
       (args[1] == -0.05 and args[2] == 0.05) or 
       (args[1] == -0.1) or
       (args[1] == -0.05) then
        if spreadModActive then
            local spreadModifier = GetSpreadModifier()
            return oldRandom(...) * spreadModifier
        end
    end
    
    return oldRandom(...)
end))

