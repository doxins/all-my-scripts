local function silentCheckHitChance()
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if silentConfig.HitChance >= 100 then
        return true
    end
    
    local chance = math.floor(Random.new():NextNumber(0, 1) * 100) / 100
    return chance <= (silentConfig.HitChance / 100)
end

local function silentGetEquippedWeapon()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    
    local weaponName = tool.Name
    if string.find(weaponName, "%[") and string.find(weaponName, "%]") then
        local split = string.split(string.split(weaponName, "[")[2], "]")
        return split[1]
    end
    
    return weaponName
end

local function silentGetFOV()
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not silentConfig.GunFOV.Enabled then
        return 120 -- Default FOV radius
    end
    
    local weapon = silentGetEquippedWeapon()
    if weapon and silentConfig.GunFOV[weapon] then
        return silentConfig.GunFOV[weapon]
    end
    
    return 120
end

local function silentUpdateCameraLookVector()
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not silentConfig.AntiAimViewer then
        silentCameraLookVector = nil
        return
    end
    
    local now = tick()
    if now - silentLastUpdateTime < 0.1 then
        return
    end
    
    silentLastUpdateTime = now
    silentCameraLookVector = Camera.CFrame.LookVector
end

