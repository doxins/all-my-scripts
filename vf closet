local function getSpoofedMousePosition()
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not silentConfig.AntiAimViewer then
        return Vector2.new(Mouse.X, Mouse.Y)
    end
    
    local now = tick()
    if now - lastSpoofUpdate < 0.016 then
        return spoofedMousePos
    end
    lastSpoofUpdate = now
    
    -- Only spoof when we have a silent aim target
    if silentTarget and silentTargetPart then
        local predictedPos = silentApplyPrediction(silentTarget, silentTargetPart)
        if predictedPos then
            local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
            if onScreen then
                spoofedMousePos = Vector2.new(screenPos.X, screenPos.Y)
                return spoofedMousePos
            end
        end
    end
    
    -- Fallback to camera look direction when no target
    local cameraPos = Camera.CFrame.Position
    local lookDir = Camera.CFrame.LookVector
    local targetPos = cameraPos + (lookDir * 100)
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
    if onScreen then
        spoofedMousePos = Vector2.new(screenPos.X, screenPos.Y)
    else
        spoofedMousePos = Vector2.new(Mouse.X, Mouse.Y)
    end
    
    return spoofedMousePos
end

