local function silentCheckFOV(position)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    -- Always return true for silent aim - work without FOV restriction
    return true
end

local function silentCheckWall(part)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not silentConfig.WallCheck then
        return true
    end
    
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.IgnoreWater = true
    
    local result = Workspace:Raycast(origin, direction, params)
    
    if result then
        return result.Instance:IsDescendantOf(part.Parent)
    end
    
    return true
end

local function silentIsValidPart(part)
    if not part or not part:IsA("BasePart") then
        return false
    end
    if string.find(part.Name, "Gun") then
        return false
    end
    return true
end

local function silentFindTargetPart(character)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    local hitPart = silentConfig.HitPart
    
    -- Force Head targeting to prevent downward curving
    local head = character:FindFirstChild("Head")
    if head and silentIsValidPart(head) then
        if silentCheckWall(head) and silentCheckFOV(head.Position) then
            return head
        end
    end
    
    -- Fallback to UpperTorso if Head is not available
    local upperTorso = character:FindFirstChild("UpperTorso")
    if upperTorso and silentIsValidPart(upperTorso) then
        if silentCheckWall(upperTorso) and silentCheckFOV(upperTorso.Position) then
            return upperTorso
        end
    end
    
    -- Fallback to HumanoidRootPart
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and silentIsValidPart(root) then
        if silentCheckWall(root) and silentCheckFOV(root.Position) then
            return root
        end
    end
    
    return nil
end

local function silentGetNearestPoint(part)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not part then
        return nil
    end
    
    -- Simply return the part's position to avoid curving issues
    -- The part selection already finds the closest part to cursor
    return part.Position
end

local function silentFindTarget()
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    local bestPlayer = nil
    local bestPart = nil
    local bestDist = math.huge
    local maxScreenDist = 100
    
    for _, player in ipairs(Players:GetPlayers()) do
        if silentIsValidPlayer(player) then
            local character = player.Character
            local root = character:FindFirstChild("HumanoidRootPart")
            
            if root then
                local distance = (Camera.CFrame.Position - root.Position).Magnitude
                if distance <= silentConfig.MaxDistance then
                    local targetPart = silentFindTargetPart(character)
                    
                    if targetPart then
                        local dist = silentGetDistanceToMouse(targetPart.Position) * 0.6
                        local fovRadius = silentGetFOV()
                        
                        if dist < bestDist and (fovRadius * 3) > dist and dist < maxScreenDist then
                            bestDist = dist
                            bestPlayer = player
                            bestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    
    return bestPlayer, bestPart
end

local function silentResolver(player)
    local character = player.Character
    if not character then
        return
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not root or not humanoid then
        return
    end
    
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    local velocity = root.AssemblyLinearVelocity
    local moveDirection = humanoid.MoveDirection
    local velocityMag = velocity.Magnitude
    local moveMag = moveDirection.Magnitude
    
    if silentConfig.Resolver then
        silentIsDesync = false
        
        if velocityMag > silentConfig.DesyncVelocity then
            silentIsDesync = true
        elseif velocityMag < 1 and moveMag > 0.01 then
            silentIsDesync = true
        elseif velocityMag > 5 and moveMag < 0.01 then
            silentIsDesync = true
        end
    else
        silentIsDesync = false
    end
    
    if silentConfig.NoGroundShots then
        -- Only trigger on significant downward velocity (falling), not normal movement
        silentIsGroundShot = velocity.Y < -50
    else
        silentIsGroundShot = false
    end
    
    -- Only trigger on significant upward velocity (jumping/flying), not normal movement
    silentIsUpVelocity = velocity.Y > 50
end

local function silentApplyPrediction(player, part)
    local character = player.Character
    if not character then
        return nil
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    
    if not root or not part then
        return nil
    end
    
    silentResolver(player)
    
    local velocity = root.AssemblyLinearVelocity
    local moveDirection = humanoid.MoveDirection
    
    local basePos = silentGetNearestPoint(part)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    local prediction = silentGetPrediction()
    local predictedPos
    
    if silentIsDesync then
        predictedPos = basePos + (moveDirection * prediction * 16)
    elseif silentIsUpVelocity then
        predictedPos = basePos + (Vector3.new(velocity.X, 0, velocity.Z) * prediction)
    elseif silentIsGroundShot then
        predictedPos = basePos + (Vector3.new(velocity.X, velocity.Y * 0.5, velocity.Z) * prediction)
    elseif silentConfig.Prediction.Enabled then
        -- Disable Y velocity prediction to prevent downward curving
        predictedPos = basePos + (Vector3.new(velocity.X, 0, velocity.Z) * prediction)
    else
        predictedPos = basePos
    end
    
    return predictedPos
end

local function silentCheckAntiCurve(originalPos, predictedPos)
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    if not silentConfig.AntiCurve then
        return true
    end
    
    local origScreen, origOnScreen = Camera:WorldToViewportPoint(originalPos)
    local predScreen, predOnScreen = Camera:WorldToViewportPoint(predictedPos)
    
    if not (origOnScreen and predOnScreen) then
        return false
    end
    
    local mousePos = Vector2.new(Mouse.X, Mouse.Y + game:GetService("GuiService"):GetGuiInset().Y)
    
    local origDist = (Vector2.new(origScreen.X, origScreen.Y) - mousePos).Magnitude
    local predDist = (Vector2.new(predScreen.X, predScreen.Y) - mousePos).Magnitude
    
    local threshold = 5
    if predDist > origDist + threshold then
        return false
    end
    
    return true
end

