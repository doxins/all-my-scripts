local function silentIsValidPlayer(player)
    if not player or player == LocalPlayer then
        return false
    end
    
    if not player.Character then
        return false
    end
    
    local humanoid = player.Character:FindFirstChild("Humanoid")
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    local head = player.Character:FindFirstChild("Head")
    
    if not (humanoid and root and head) then
        return false
    end
    
    if humanoid.Health <= 0 then
        return false
    end
    
    local silentConfig = shared.Saved['Camera Aimbot']['Silent Aim']
    
    if silentConfig.HealthCheck and humanoid.Health < silentConfig.HealthThreshold then
        return false
    end
    
    if silentConfig.KnockedCheck then
        local bodyEffects = player.Character:FindFirstChild("BodyEffects")
        if bodyEffects then
            local ko = bodyEffects:FindFirstChild("K.O")
            if ko and ko.Value == true then
                return false
            end
        end
    end
    
    if silentConfig.GrabbedCheck then
        if player.Character:FindFirstChild("GRABBING_CONSTRAINT") then
            return false
        end
        if humanoid:FindFirstChild("Grabbed") and humanoid.Grabbed.Value then
            return false
        end
    end
    
    return true
end

local function silentWorldToViewport(position)
    local screenPos, onScreen = Camera:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function silentGetDistanceToMouse(position)
    local screenPos, onScreen = silentWorldToViewport(position)
    if not onScreen then
        return math.huge
    end
    
    -- Get real mouse position directly to ensure accuracy
    local realMousePos = UserInputService:GetMouseLocation()
