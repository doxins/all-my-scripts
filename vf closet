end)

-- ───────────────────────────────────────────────────────────────
-- Can Target Player Function: Checks if player can be targeted based on conditions
-- ───────────────────────────────────────────────────────────────
local function canTargetPlayer(player)
    if not player or not player.Character then return false end
   
    local selectCond = whenSelecting
   
    if selectCond["Self-Knocked"] and isKnocked(LocalPlayer) then
        return false
    end
    if selectCond["Knocked"] and isKnocked(player) then
        return false
    end
   
    if selectCond["Visible"] and not isTargetVisible(player.Character) then
        return false
    end
   
    return true
end

